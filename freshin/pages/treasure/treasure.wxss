.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.again {
  padding: 16rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.more {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #8A8580;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 58, 56, 0.06);
}

.record-card {
  margin-bottom: 24rpx;
}

.r-time {
  font-size: 22rpx;
  color: #B9B1A9;
}

.r-title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.r-text {
  margin-top: 12rpx;
  color: #6B6660;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.r-media {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
}

.thumb {
  width: 172rpx;
  height: 172rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  position: relative;
}

.v-dur {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.end {
  margin-top: 16rpx;
  text-align: center;
  color: #B9B1A9;
  font-size: 24rpx;
}
