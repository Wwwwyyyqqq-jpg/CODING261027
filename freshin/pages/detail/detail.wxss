.toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}

.more {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #8A8580;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 58, 56, 0.06);
}

.d-title {
  font-size: 44rpx;
  font-weight: 600;
}

.d-time {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #B9B1A9;
}

.d-text {
  margin-top: 28rpx;
  line-height: 1.8;
  color: #4A4643;
}

.d-media {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.media-cell {
  width: 100%;
  height: 320rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  position: relative;
}

.media-cell.video .v-play {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
