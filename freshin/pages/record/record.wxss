.field {
  margin-bottom: 24rpx;
}

.title-input {
  font-size: 34rpx;
  font-weight: 600;
}

.content-input {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.ph {
  color: #C9C1B9;
}

.counter {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: #B9B1A9;
}

.label {
  margin: 32rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: #8A8580;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cell {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.cell.add {
  background: #FFFFFF;
  color: #C9C1B9;
  font-size: 56rpx;
  border: 2rpx dashed #D8D0C7;
}

.video-cell {
  height: 240rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.v-emoji {
  font-size: 80rpx;
}

.v-duration {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.video-add {
  height: 140rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 2rpx dashed #D8D0C7;
  color: #8A8580;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn {
  margin-top: 56rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
}
